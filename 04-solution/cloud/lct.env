# lct.env — общие настройки для up.sh / down.sh / status.sh (source-ится ими).
# Переопределяется переменными окружения, напр.: PLATFORM=standard-v3-t4i PREEMPTIBLE=1 ./up.sh
# shellcheck shell=bash

YC="${YC:-$HOME/yandex-cloud/bin/yc}"          # CLI 1.34.0, профиль lct2026 (SA lct-worker, editor на каталог)
FOLDER_ID="${FOLDER_ID:-b1grruo0n4tcqspfngdf}" # каталог default в облаке b1gqis7qavhsob55m0d1
ZONE="${ZONE:-ru-central1-d}"                  # T4/T4i явно документированы для ru-central1-d (см. REPORT.md)

NET_NAME="${NET_NAME:-lct-net}"
SUBNET_NAME="${SUBNET_NAME:-lct-subnet}"
SUBNET_RANGE="${SUBNET_RANGE:-10.10.0.0/24}"   # не пересекается с default-подсетями 10.128–10.130.0.0/24

VM_NAME="${VM_NAME:-lct-gpu}"
BOOT_DISK_NAME="${BOOT_DISK_NAME:-lct-gpu-boot}"
PLATFORM="${PLATFORM:-standard-v3-t4}"         # или standard-v3-t4i (24 ГБ VRAM, GPU в 2,25 раза дороже)
CORES="${CORES:-4}"                            # минимальная ступень платформ *-t4/*-t4i: 4 vCPU / 16 ГБ
MEMORY_GB="${MEMORY_GB:-16}"
GPUS="${GPUS:-1}"
PREEMPTIBLE="${PREEMPTIBLE:-0}"                # 1 — прерываемая ВМ (дешевле, живёт ≤24 ч, могут выключить в любой момент)

IMAGE_ID="${IMAGE_ID:-fd8qb5sstf8h1lk8pmb8}"   # ubuntu-2204-lts-cuda-12-2-v20260813 (NVIDIA Driver 535, CUDA 12.2)
IMAGE_FAMILY="${IMAGE_FAMILY:-ubuntu-2204-lts-cuda-12-2}"
DISK_TYPE="${DISK_TYPE:-network-ssd}"
DISK_SIZE_GB="${DISK_SIZE_GB:-60}"

VM_USER="${VM_USER:-artem}"                    # пользователь на ВМ (создаёт cloud-init)
SSH_PUBKEY_FILE="${SSH_PUBKEY_FILE:-$HOME/.ssh/id_ed25519.pub}"

# файлы рядом со скриптами
LCT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLOUD_INIT_TEMPLATE="${CLOUD_INIT_TEMPLATE:-$LCT_DIR/cloud-init.yaml}"
CLOUD_INIT_RENDERED="${CLOUD_INIT_RENDERED:-$LCT_DIR/cloud-init.rendered.yaml}"
IP_FILE="${IP_FILE:-$LCT_DIR/lct-gpu.ip}"
PRICES_JSON="${PRICES_JSON:-$LCT_DIR/prices.json}"
