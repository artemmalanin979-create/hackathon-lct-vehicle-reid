# Данные и веса — не в git
data/
datasets/
# Исключение: скрипты подготовки обучающих наборов — часть исходного кода решения,
# ТЗ п.13 требует открытый код. Под общее правило datasets/ они попали случайно.
!04-solution/training/src/datasets/
!04-solution/training/src/evidence/datasets/
*.pt
*.pth
*.onnx
# Исключение: веса сдаваемого сервиса обязаны ехать в репозитории —
# ТЗ п.8 требует инференс без доступа в интернет, веса в составе решения.
!04-solution/service/model/*.onnx
*.engine
*.ckpt
weights/
checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Результаты прогонов
runs/
outputs/
wandb/
mlruns/
*.log

# Системное
.DS_Store
.matplotlib/
.cache/
.idea/
.vscode/

# Эмбеддинги и промежуточные векторы — воспроизводятся прогоном
*.npy
*.ids
.worker-payload/

# Персональные данные участников — не в git (уезжают только в презентацию)
05-presentation/team-data.md

# Вырожденные прогоны сплита — воспроизводятся eval_degenerate.py
04-solution/split/out/evalrun/*.npz
04-solution/split/out/evalrun/cli_*.json

# Финальные сдаваемые артефакты — исключение из правила *.npy:
# embeddings.npy входит в состав сдачи (ТЗ разд. 8)
!04-solution/service/artifacts-final/
!04-solution/service/artifacts-final/embeddings.npy

# Колёса зависимостей входят в состав решения (офлайн-сборка образа)
!04-solution/service/wheels/
!04-solution/service/wheels/*.whl

# Готовая презентация — содержит персональные данные участников (слайд 9).
# Сдаётся отдельной ссылкой, в репозиторий не кладём.
05-presentation/*.pptx

# токены и ключи — никогда в git
*token*
*.key
05-presentation/checks/
